{
    "id": "7176bb5d-905c-4a0d-9e07-b2531b20bdc5",
    "subjectId": "38fe1eb2-f38f-4dc6-9e65-8711d6af8f11",
    "name": "हिंदी अलंकार",
    "description": "<!DOCTYPE html>\n<html lang=\"hi\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>अलंकार — TET Special</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --bg: #0d0d0d;\n    --surface: #161616;\n    --card: #1e1e1e;\n    --border: #2a2a2a;\n    --accent: #c0392b;\n    --accent2: #e74c3c;\n    --gold: #f39c12;\n    --green: #27ae60;\n    --blue: #2980b9;\n    --purple: #8e44ad;\n    --text: #e8e8e8;\n    --muted: #888;\n    --tag-bg: #2a1a1a;\n  }\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  body {\n    background: var(--bg);\n    color: var(--text);\n    font-family: 'Noto Sans Devanagari', sans-serif;\n    min-height: 100vh;\n  }\n\n  header {\n    background: linear-gradient(135deg, #1a0000 0%, #2d0000 50%, #1a0000 100%);\n    border-bottom: 2px solid var(--accent);\n    padding: 24px 16px 20px;\n    text-align: center;\n    position: relative;\n    overflow: hidden;\n  }\n  header::before {\n    content: '';\n    position: absolute;\n    top: -50%; left: -50%;\n    width: 200%; height: 200%;\n    background: radial-gradient(ellipse at center, rgba(192,57,43,0.08) 0%, transparent 70%);\n    pointer-events: none;\n  }\n  .header-badge {\n    display: inline-block;\n    background: var(--accent);\n    color: #fff;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 2px;\n    padding: 4px 12px;\n    border-radius: 20px;\n    margin-bottom: 10px;\n    font-family: 'Baloo 2', sans-serif;\n  }\n  header h1 {\n    font-family: 'Baloo 2', sans-serif;\n    font-size: 32px;\n    font-weight: 800;\n    color: #fff;\n    line-height: 1.2;\n  }\n  header h1 span { color: var(--accent2); }\n  header p {\n    margin-top: 8px;\n    color: var(--muted);\n    font-size: 13px;\n  }\n\n  .tabs {\n    display: flex;\n    overflow-x: auto;\n    background: var(--surface);\n    border-bottom: 1px solid var(--border);\n    padding: 0 12px;\n    gap: 4px;\n    scrollbar-width: none;\n  }\n  .tabs::-webkit-scrollbar { display: none; }\n  .tab {\n    flex-shrink: 0;\n    padding: 12px 16px;\n    font-size: 13px;\n    font-weight: 600;\n    color: var(--muted);\n    cursor: pointer;\n    border-bottom: 3px solid transparent;\n    transition: all 0.2s;\n    white-space: nowrap;\n    font-family: 'Noto Sans Devanagari', sans-serif;\n  }\n  .tab.active { color: var(--accent2); border-bottom-color: var(--accent2); }\n  .tab:hover { color: var(--text); }\n\n  .content { padding: 16px; max-width: 700px; margin: 0 auto; }\n\n  .section { display: none; }\n  .section.active { display: block; }\n\n  /* TRICK BOX */\n  .trick-box {\n    background: linear-gradient(135deg, #1a1000, #1e1500);\n    border: 1.5px solid var(--gold);\n    border-radius: 12px;\n    padding: 16px;\n    margin-bottom: 20px;\n  }\n  .trick-box .trick-label {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 2px;\n    color: var(--gold);\n    margin-bottom: 8px;\n    font-family: 'Baloo 2', sans-serif;\n  }\n  .trick-box h3 {\n    font-size: 18px;\n    font-weight: 700;\n    color: #ffd700;\n    line-height: 1.4;\n  }\n  .trick-box p {\n    margin-top: 8px;\n    font-size: 13px;\n    color: #ccc;\n    line-height: 1.6;\n  }\n\n  /* ALANKAR CARD */\n  .alankar-card {\n    background: var(--card);\n    border: 1px solid var(--border);\n    border-radius: 12px;\n    margin-bottom: 16px;\n    overflow: hidden;\n    transition: border-color 0.2s;\n  }\n  .alankar-card:hover { border-color: var(--accent); }\n\n  .card-header {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 14px 16px;\n    cursor: pointer;\n    user-select: none;\n  }\n  .card-num {\n    width: 36px; height: 36px;\n    border-radius: 50%;\n    display: flex; align-items: center; justify-content: center;\n    font-family: 'Baloo 2', sans-serif;\n    font-weight: 800;\n    font-size: 15px;\n    flex-shrink: 0;\n  }\n  .card-title-wrap { flex: 1; }\n  .card-name {\n    font-size: 18px;\n    font-weight: 700;\n    line-height: 1.2;\n  }\n  .card-type {\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: 1.5px;\n    margin-top: 2px;\n    font-family: 'Baloo 2', sans-serif;\n  }\n  .card-arrow {\n    font-size: 18px;\n    color: var(--muted);\n    transition: transform 0.3s;\n  }\n  .alankar-card.open .card-arrow { transform: rotate(180deg); }\n\n  .card-body {\n    display: none;\n    padding: 0 16px 16px;\n    border-top: 1px solid var(--border);\n    padding-top: 14px;\n  }\n  .alankar-card.open .card-body { display: block; }\n\n  .def-box {\n    background: #111;\n    border-left: 3px solid;\n    border-radius: 0 8px 8px 0;\n    padding: 12px 14px;\n    margin-bottom: 14px;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .pehchaan {\n    background: #0d1a0d;\n    border: 1px solid #1e4d1e;\n    border-radius: 8px;\n    padding: 10px 14px;\n    margin-bottom: 12px;\n  }\n  .pehchaan-label {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 1.5px;\n    color: var(--green);\n    margin-bottom: 6px;\n    font-family: 'Baloo 2', sans-serif;\n  }\n  .pehchaan p { font-size: 13px; color: #b8e6b8; line-height: 1.6; }\n\n  .examples-label {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 1.5px;\n    color: var(--muted);\n    margin-bottom: 8px;\n    font-family: 'Baloo 2', sans-serif;\n  }\n  .example-item {\n    background: #111;\n    border-radius: 8px;\n    padding: 10px 12px;\n    margin-bottom: 8px;\n    font-size: 14px;\n    line-height: 1.6;\n  }\n  .example-item .explain {\n    font-size: 12px;\n    color: var(--muted);\n    margin-top: 4px;\n  }\n  .highlight { font-weight: 700; }\n\n  .trick-mini {\n    background: #1a1500;\n    border: 1px solid #3d3000;\n    border-radius: 8px;\n    padding: 10px 14px;\n    margin-top: 12px;\n  }\n  .trick-mini-label {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 1.5px;\n    color: var(--gold);\n    margin-bottom: 4px;\n    font-family: 'Baloo 2', sans-serif;\n  }\n  .trick-mini p { font-size: 13px; color: #ffd88a; line-height: 1.6; }\n\n  .tet-tag {\n    display: inline-block;\n    background: var(--accent);\n    color: #fff;\n    font-size: 10px;\n    font-weight: 700;\n    padding: 2px 8px;\n    border-radius: 4px;\n    margin-bottom: 10px;\n    font-family: 'Baloo 2', sans-serif;\n    letter-spacing: 1px;\n  }\n\n  /* COLORS PER TYPE */\n  .shabdalankar .card-num { background: #1a0a2e; color: #a855f7; }\n  .shabdalankar .card-name { color: #c084fc; }\n  .shabdalankar .card-type { color: #a855f7; }\n  .shabdalankar .def-box { border-color: #a855f7; }\n  .shabdalankar:hover { border-color: #a855f7; }\n\n  .arthalankar .card-num { background: #0a1e2e; color: #60a5fa; }\n  .arthalankar .card-name { color: #93c5fd; }\n  .arthalankar .card-type { color: #60a5fa; }\n  .arthalankar .def-box { border-color: #60a5fa; }\n  .arthalankar:hover { border-color: #60a5fa; }\n\n  /* OVERVIEW TABLE */\n  .overview-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 13px;\n    margin-bottom: 20px;\n  }\n  .overview-table th {\n    background: #1e1e1e;\n    padding: 10px 12px;\n    text-align: left;\n    font-size: 11px;\n    letter-spacing: 1.5px;\n    color: var(--muted);\n    font-family: 'Baloo 2', sans-serif;\n    border-bottom: 1px solid var(--border);\n  }\n  .overview-table td {\n    padding: 10px 12px;\n    border-bottom: 1px solid var(--border);\n    vertical-align: top;\n  }\n  .overview-table tr:last-child td { border-bottom: none; }\n  .type-s { color: #c084fc; font-weight: 700; }\n  .type-a { color: #93c5fd; font-weight: 700; }\n\n  /* QUIZ */\n  .quiz-card {\n    background: var(--card);\n    border: 1px solid var(--border);\n    border-radius: 12px;\n    padding: 16px;\n    margin-bottom: 16px;\n  }\n  .quiz-q {\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.6;\n    margin-bottom: 14px;\n  }\n  .quiz-opts { display: flex; flex-direction: column; gap: 8px; }\n  .quiz-opt {\n    background: #111;\n    border: 1.5px solid var(--border);\n    border-radius: 8px;\n    padding: 10px 14px;\n    font-size: 14px;\n    cursor: pointer;\n    transition: all 0.2s;\n    text-align: left;\n    color: var(--text);\n    font-family: 'Noto Sans Devanagari', sans-serif;\n  }\n  .quiz-opt:hover { border-color: var(--accent); background: #1a0000; }\n  .quiz-opt.correct { border-color: var(--green); background: #0d1a0d; color: #6ee77e; }\n  .quiz-opt.wrong { border-color: var(--accent2); background: #1a0000; color: #f87171; }\n  .quiz-opt.reveal { border-color: var(--green); background: #0d1a0d; color: #6ee77e; }\n  .quiz-explain {\n    display: none;\n    margin-top: 10px;\n    background: #111;\n    border-radius: 8px;\n    padding: 10px 14px;\n    font-size: 13px;\n    color: #ccc;\n    line-height: 1.6;\n    border-left: 3px solid var(--gold);\n  }\n  .quiz-explain.show { display: block; }\n  .score-bar {\n    background: var(--card);\n    border: 1px solid var(--border);\n    border-radius: 12px;\n    padding: 16px;\n    text-align: center;\n    margin-bottom: 16px;\n    font-size: 14px;\n  }\n  .score-num {\n    font-family: 'Baloo 2', sans-serif;\n    font-size: 36px;\n    font-weight: 800;\n    color: var(--gold);\n  }\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"header-badge\">TET HINDI SPECIAL</div>\n  <h1>हिंदी <span>अलंकार</span></h1>\n  <p>सम्पूर्ण परिभाषा • पहचान की तरकीब • याद करने की Trick • Practice MCQ</p>\n</header>\n\n<div class=\"tabs\">\n  <div class=\"tab active\" onclick=\"showSection('overview')\">📋 Overview</div>\n  <div class=\"tab\" onclick=\"showSection('shabdalankar')\">🔤 शब्दालंकार</div>\n  <div class=\"tab\" onclick=\"showSection('arthalankar')\">💡 अर्थालंकार</div>\n  <div class=\"tab\" onclick=\"showSection('trick')\">🧠 Master Trick</div>\n  <div class=\"tab\" onclick=\"showSection('quiz')\">✏️ Quiz</div>\n</div>\n\n<!-- ===== OVERVIEW ===== -->\n<div class=\"content\">\n<div id=\"overview\" class=\"section active\">\n\n  <div class=\"trick-box\" style=\"margin-top:4px;\">\n    <div class=\"trick-label\">⚡ SUPER TRICK — पहले यह याद करो</div>\n    <h3>शब्द = आवाज़ / ध्वनि<br>अर्थ = मतलब / भाव</h3>\n    <p>जहाँ <strong style=\"color:#ffd700\">शब्द की ध्वनि / उच्चारण</strong> से चमत्कार हो → <strong style=\"color:#c084fc\">शब्दालंकार</strong><br>\n    जहाँ <strong style=\"color:#ffd700\">अर्थ / मतलब</strong> से चमत्कार हो → <strong style=\"color:#93c5fd\">अर्थालंकार</strong></p>\n  </div>\n\n  <table class=\"overview-table\">\n    <thead>\n      <tr>\n        <th>#</th>\n        <th>अलंकार</th>\n        <th>प्रकार</th>\n        <th>एक लाइन पहचान</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>1</td><td><strong>अनुप्रास</strong></td>\n        <td><span class=\"type-s\">शब्द</span></td>\n        <td>एक ही व्यंजन बार-बार</td>\n      </tr>\n      <tr>\n        <td>2</td><td><strong>यमक</strong></td>\n        <td><span class=\"type-s\">शब्द</span></td>\n        <td>शब्द वही, अर्थ नया</td>\n      </tr>\n      <tr>\n        <td>3</td><td><strong>श्लेष</strong></td>\n        <td><span class=\"type-s\">शब्द</span></td>\n        <td>एक शब्द, एक बार, दो अर्थ</td>\n      </tr>\n      <tr>\n        <td>4</td><td><strong>उपमा</strong></td>\n        <td><span class=\"type-a\">अर्थ</span></td>\n        <td>सा, सी, सम, जैसा</td>\n      </tr>\n      <tr>\n        <td>5</td><td><strong>रूपक</strong></td>\n        <td><span class=\"type-a\">अर्थ</span></td>\n        <td>एक ही मान लिया (भेद नहीं)</td>\n      </tr>\n      <tr>\n        <td>6</td><td><strong>उत्प्रेक्षा</strong></td>\n        <td><span class=\"type-a\">अर्थ</span></td>\n        <td>मनो, जनु, मानो, ज्यों</td>\n      </tr>\n      <tr>\n        <td>7</td><td><strong>अतिशयोक्ति</strong></td>\n        <td><span class=\"type-a\">अर्थ</span></td>\n        <td>बढ़ा-चढ़ाकर कहना</td>\n      </tr>\n      <tr>\n        <td>8</td><td><strong>मानवीकरण</strong></td>\n        <td><span class=\"type-a\">अर्थ</span></td>\n        <td>निर्जीव में जीव वाले काम</td>\n      </tr>\n    </tbody>\n  </table>\n\n</div>\n\n<!-- ===== SHABDALANKAR ===== -->\n<div id=\"shabdalankar\" class=\"section\">\n\n  <!-- ANUPRAS -->\n  <div class=\"alankar-card shabdalankar\" onclick=\"toggleCard(this)\">\n    <div class=\"card-header\">\n      <div class=\"card-num\">1</div>\n      <div class=\"card-title-wrap\">\n        <div class=\"card-name\">अनुप्रास अलंकार</div>\n        <div class=\"card-type\">SHABDALANKAR</div>\n      </div>\n      <div class=\"card-arrow\">▼</div>\n    </div>\n    <div class=\"card-body\">\n      <span class=\"tet-tag\">TET में सबसे ज़्यादा आता है</span>\n      <div class=\"def-box\">\n        <strong>परिभाषा:</strong> जहाँ किसी <strong>एक व्यंजन (Consonant)</strong> की एक ही पंक्ति में <strong>बार-बार आवृत्ति</strong> (दोहराव) हो, वहाँ <strong>अनुप्रास अलंकार</strong> होता है।\n      </div>\n      <div class=\"pehchaan\">\n        <div class=\"pehchaan-label\">🔍 INSTANT PEHCHAAN</div>\n        <p>→ एक ही अक्षर बार-बार सुनाई दे (जैसे क-क-क, म-म-म)<br>\n        → पंक्ति पढ़ते समय \"music\" जैसा लगे</p>\n      </div>\n      <div class=\"examples-label\">EXAMPLES</div>\n      <div class=\"example-item\">\n        \"<span class=\"highlight\" style=\"color:#c084fc\">च</span>ारु <span class=\"highlight\" style=\"color:#c084fc\">च</span>ंद्र की <span class=\"highlight\" style=\"color:#c084fc\">च</span>ंचल किरणें\"\n        <div class=\"explain\">'च' की बार-बार आवृत्ति → अनुप्रास</div>\n      </div>\n      <div class=\"example-item\">\n        \"<span class=\"highlight\" style=\"color:#c084fc\">क</span>ानन <span class=\"highlight\" style=\"color:#c084fc\">क</span>ुसुम <span class=\"highlight\" style=\"color:#c084fc\">क</span>ोमल <span class=\"highlight\" style=\"color:#c084fc\">क</span>ल्याणी\"\n        <div class=\"explain\">'क' छह बार → अनुप्रास</div>\n      </div>\n      <div class=\"example-item\">\n        \"<span class=\"highlight\" style=\"color:#c084fc\">म</span>धुर <span class=\"highlight\" style=\"color:#c084fc\">म</span>नोहर <span class=\"highlight\" style=\"color:#c084fc\">म</span>धुर <span class=\"highlight\" style=\"color:#c084fc\">म</span>ेरे दीपक जल\"\n        <div class=\"explain\">'म' की आवृत्ति → अनुप्रास</div>\n      </div>\n      <div class=\"trick-mini\">\n        <div class=\"trick-mini-label\">🧠 TRICK TO REMEMBER</div>\n        <p><strong>\"अनु = Follow करना, प्रास = ध्वनि\"</strong><br>\n        एक ध्वनि को Follow करते जाओ पूरी लाइन में — अनुप्रास!</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- YAMAK -->\n  <div class=\"alankar-card shabdalankar\" onclick=\"toggleCard(this)\">\n    <div class=\"card-header\">\n      <div class=\"card-num\">2</div>\n      <div class=\"card-title-wrap\">\n        <div class=\"card-name\">यमक अलंकार</div>\n        <div class=\"card-type\">SHABDALANKAR</div>\n      </div>\n      <div class=\"card-arrow\">▼</div>\n    </div>\n    <div class=\"card-body\">\n      <span class=\"tet-tag\">TET में बहुत आता है</span>\n      <div class=\"def-box\">\n        <strong>परिभाषा:</strong> जहाँ कोई <strong>शब्द एक से अधिक बार</strong> आए और हर बार उसका <strong>अर्थ अलग-अलग</strong> हो, वहाँ <strong>यमक अलंकार</strong> होता है।\n      </div>\n      <div class=\"pehchaan\">\n        <div class=\"pehchaan-label\">🔍 INSTANT PEHCHAAN</div>\n        <p>→ Same शब्द 2+ बार दिखे<br>\n        → दोनों बार meaning अलग हो<br>\n        → \"वही मनुष्य है कि जो मनुष्य के लिए मरे\" ← यही था question!</p>\n      </div>\n      <div class=\"examples-label\">EXAMPLES</div>\n      <div class=\"example-item\">\n        \"कनक कनक ते सौगुनी, मादकता अधिकाय\"\n        <div class=\"explain\"><span class=\"highlight\" style=\"color:#c084fc\">कनक</span> = सोना | <span class=\"highlight\" style=\"color:#c084fc\">कनक</span> = धतूरा → यमक</div>\n      </div>\n      <div class=\"example-item\">\n        \"माला फेरत जुग भया, फिरा न मन का फेर\"\n        <div class=\"explain\"><span class=\"highlight\" style=\"color:#c084fc\">फेर</span> = घुमाना | <span class=\"highlight\" style=\"color:#c084fc\">फेर</span> = विकार/बुराई → यमक</div>\n      </div>\n      <div class=\"trick-mini\">\n        <div class=\"trick-mini-label\">🧠 TRICK TO REMEMBER</div>\n        <p><strong>यमक = \"यही शब्द, नया मकसद\"</strong><br>\n        <strong>य</strong>ही + <strong>म</strong>कसद बदला = <strong>यमक</strong><br>\n        शब्द Same ✅ | अर्थ Different ✅</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- SHLESH -->\n  <div class=\"alankar-card shabdalankar\" onclick=\"toggleCard(this)\">\n    <div class=\"card-header\">\n      <div class=\"card-num\">3</div>\n      <div class=\"card-title-wrap\">\n        <div class=\"card-name\">श्लेष अलंकार</div>\n        <div class=\"card-type\">SHABDALANKAR</div>\n      </div>\n      <div class=\"card-arrow\">▼</div>\n    </div>\n    <div class=\"card-body\">\n      <span class=\"tet-tag\">यमक से confuse न हो!</span>\n      <div class=\"def-box\">\n        <strong>परिभाषा:</strong> जहाँ कोई <strong>एक शब्द एक ही बार</strong> आए लेकिन उसके <strong>एक साथ दो या दो से अधिक अर्थ</strong> निकलें, वहाँ <strong>श्लेष अलंकार</strong> होता है।\n      </div>\n      <div class=\"pehchaan\">\n        <div class=\"pehchaan-label\">🔍 INSTANT PEHCHAAN</div>\n        <p>→ शब्द सिर्फ एक बार आता है<br>\n        → लेकिन उसके 2 अर्थ एक साथ निकलते हैं<br>\n        → \"श्लेष = चिपकना\" — दो अर्थ एक शब्द में चिपके हैं</p>\n      </div>\n      <div class=\"examples-label\">EXAMPLES</div>\n      <div class=\"example-item\">\n        \"रहिमन <span class=\"highlight\" style=\"color:#c084fc\">पानी</span> राखिए, बिन पानी सब सून\"\n        <div class=\"explain\"><span class=\"highlight\" style=\"color:#c084fc\">पानी</span> के अर्थ → (1) जल (2) इज्जत/आबरू (3) चमक — श्लेष</div>\n      </div>\n      <div class=\"example-item\">\n        \"<span class=\"highlight\" style=\"color:#c084fc\">चिरजीवो जोरी जुरे</span>, कृष्ण कन्हाई\"\n        <div class=\"explain\">\"जोरी\" = जोड़ा और = जड़ी — एक शब्द दो अर्थ → श्लेष</div>\n      </div>\n      <div class=\"trick-mini\">\n        <div class=\"trick-mini-label\">🧠 TRICK — यमक vs श्लेष</div>\n        <p>\n        <strong>यमक:</strong> शब्द 2 बार आए, अर्थ 2 अलग ✦<br>\n        <strong>श्लेष:</strong> शब्द 1 बार आए, अर्थ 2 साथ ✦<br>\n        <br>\n        Trick: <strong>श्लेष = SLICE</strong> (एक चीज़ को slice करो — 2 टुकड़े अर्थ)\n        </p>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<!-- ===== ARTHALANKAR ===== -->\n<div id=\"arthalankar\" class=\"section\">\n\n  <!-- UPMA -->\n  <div class=\"alankar-card arthalankar\" onclick=\"toggleCard(this)\">\n    <div class=\"card-header\">\n      <div class=\"card-num\">4</div>\n      <div class=\"card-title-wrap\">\n        <div class=\"card-name\">उपमा अलंकार</div>\n        <div class=\"card-type\">ARTHALANKAR</div>\n      </div>\n      <div class=\"card-arrow\">▼</div>\n    </div>\n    <div class=\"card-body\">\n      <span class=\"tet-tag\">TET में No.1 — ज़रूर आता है</span>\n      <div class=\"def-box\">\n        <strong>परिभाषा:</strong> जहाँ किसी <strong>उपमेय (जिसकी तुलना हो)</strong> की किसी <strong>उपमान (जिससे तुलना हो)</strong> से <strong>समानता</strong> बताई जाए और <strong>वाचक शब्द</strong> (सा, सी, सम, जैसा, ज्यों) हो, वहाँ <strong>उपमा अलंकार</strong> होता है।\n      </div>\n      <div class=\"pehchaan\">\n        <div class=\"pehchaan-label\">🔍 INSTANT PEHCHAAN — वाचक शब्द देखो</div>\n        <p>→ <strong>सा, सी, से, सम, जैसा, जैसी, ज्यों, सरिस, इव</strong> शब्द दिखे<br>\n        → तुलना की जा रही हो<br>\n        → दो अलग-अलग चीज़ें हों</p>\n      </div>\n      <div class=\"examples-label\">EXAMPLES</div>\n      <div class=\"example-item\">\n        \"हरिपद कोमल कमल <span class=\"highlight\" style=\"color:#60a5fa\">से</span>\"\n        <div class=\"explain\">उपमेय = हरिपद | उपमान = कमल | वाचक = से → उपमा</div>\n      </div>\n      <div class=\"example-item\">\n        \"मुख चंद्रमा <span class=\"highlight\" style=\"color:#60a5fa\">सा</span> सुंदर है\"\n        <div class=\"explain\">उपमेय = मुख | उपमान = चंद्रमा | वाचक = सा → उपमा</div>\n      </div>\n      <div class=\"trick-mini\">\n        <div class=\"trick-mini-label\">🧠 TRICK</div>\n        <p><strong>\"उपमा = सा/सी/से वाला\"</strong><br>\n        जैसे ही सा, सी, से, सम, ज्यों दिखे — उपमा समझो!</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- RUPAK -->\n  <div class=\"alankar-card arthalankar\" onclick=\"toggleCard(this)\">\n    <div class=\"card-header\">\n      <div class=\"card-num\">5</div>\n      <div class=\"card-title-wrap\">\n        <div class=\"card-name\">रूपक अलंकार</div>\n        <div class=\"card-type\">ARTHALANKAR</div>\n      </div>\n      <div class=\"card-arrow\">▼</div>\n    </div>\n    <div class=\"card-body\">\n      <span class=\"tet-tag\">उपमा से confuse होता है</span>\n      <div class=\"def-box\">\n        <strong>परिभाषा:</strong> जहाँ <strong>उपमेय और उपमान में कोई अंतर न माना जाए</strong>, यानी उपमेय को ही उपमान <strong>बता दिया जाए</strong> (अभेद आरोप), वहाँ <strong>रूपक अलंकार</strong> होता है।\n      </div>\n      <div class=\"pehchaan\">\n        <div class=\"pehchaan-label\">🔍 INSTANT PEHCHAAN</div>\n        <p>→ कोई वाचक शब्द (सा/सी) नहीं होता<br>\n        → दो चीज़ों को एक मान लिया जाता है<br>\n        → \"मुख + चंद्रमा\" → \"मुख-चंद्रमा\" (compound बनता है)</p>\n      </div>\n      <div class=\"examples-label\">EXAMPLES</div>\n      <div class=\"example-item\">\n        \"<span class=\"highlight\" style=\"color:#60a5fa\">मुख-चंद्र</span> निहारत रहत\"\n        <div class=\"explain\">मुख को चंद्र ही मान लिया — रूपक (सा/सी नहीं है)</div>\n      </div>\n      <div class=\"example-item\">\n        \"<span class=\"highlight\" style=\"color:#60a5fa\">चरण-कमल</span> बंदौ हरिराई\"\n        <div class=\"explain\">चरण = कमल मान लिया → रूपक</div>\n      </div>\n      <div class=\"example-item\">\n        \"अंबर-पनघट में डुबो रही तारा-घट ऊषा-नागरी\"\n        <div class=\"explain\">अंबर = पनघट, तारे = घट, ऊषा = नागरी → रूपक</div>\n      </div>\n      <div class=\"trick-mini\">\n        <div class=\"trick-mini-label\">🧠 TRICK — उपमा vs रूपक</div>\n        <p>\n        <strong>उपमा:</strong> \"मुख चंद्र <u>सा</u> है\" (सा = अलग हैं)<br>\n        <strong>रूपक:</strong> \"मुख-चंद्र\" (एक ही हैं, भेद नहीं)<br><br>\n        Trick: <strong>रूपक = Role Play</strong> — उपमेय ने उपमान का role play किया!\n        </p>\n      </div>\n    </div>\n  </div>\n\n  <!-- UTPREKSHA -->\n  <div class=\"alankar-card arthalankar\" onclick=\"toggleCard(this)\">\n    <div class=\"card-header\">\n      <div class=\"card-num\">6</div>\n      <div class=\"card-title-wrap\">\n        <div class=\"card-name\">उत्प्रेक्षा अलंकार</div>\n        <div class=\"card-type\">ARTHALANKAR</div>\n      </div>\n      <div class=\"card-arrow\">▼</div>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"def-box\">\n        <strong>परिभाषा:</strong> जहाँ उपमेय में उपमान की <strong>संभावना</strong> या <strong>कल्पना</strong> की जाए — यानी यह <strong>शायद यही है</strong> जैसा भाव हो — वहाँ <strong>उत्प्रेक्षा अलंकार</strong> होता है।\n      </div>\n      <div class=\"pehchaan\">\n        <div class=\"pehchaan-label\">🔍 INSTANT PEHCHAAN — ये शब्द देखो</div>\n        <p>→ <strong>मनो, जनु, मानो, ज्यों, जान पड़ता है, लगता है, मनहुँ</strong><br>\n        → \"शायद यही होगा\" वाला भाव</p>\n      </div>\n      <div class=\"examples-label\">EXAMPLES</div>\n      <div class=\"example-item\">\n        \"सोहत ओढ़े पीत-पट, श्याम सलोने गात। <span class=\"highlight\" style=\"color:#60a5fa\">मनो</span> नीलमणि-शैल पर, आतप परयो प्रभात।\"\n        <div class=\"explain\">\"मनो\" → संभावना → उत्प्रेक्षा</div>\n      </div>\n      <div class=\"trick-mini\">\n        <div class=\"trick-mini-label\">🧠 TRICK</div>\n        <p><strong>\"उत्प्रेक्षा = मनो/जनो वाला\"</strong><br>\n        मनो/जनो/मानो दिखे → उत्प्रेक्षा पक्का!</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- ATISHYOKTI -->\n  <div class=\"alankar-card arthalankar\" onclick=\"toggleCard(this)\">\n    <div class=\"card-header\">\n      <div class=\"card-num\">7</div>\n      <div class=\"card-title-wrap\">\n        <div class=\"card-name\">अतिशयोक्ति अलंकार</div>\n        <div class=\"card-type\">ARTHALANKAR</div>\n      </div>\n      <div class=\"card-arrow\">▼</div>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"def-box\">\n        <strong>परिभाषा:</strong> जहाँ किसी बात को <strong>बहुत बढ़ा-चढ़ाकर</strong> कहा जाए जो <strong>वास्तव में असंभव या अत्यंत अतिरंजित</strong> हो, वहाँ <strong>अतिशयोक्ति अलंकार</strong> होता है।\n      </div>\n      <div class=\"examples-label\">EXAMPLES</div>\n      <div class=\"example-item\">\n        \"हनुमान की पूँछ में, लग न पाई आग। लंका सगरी जल गई, गए निशाचर भाग।\"\n        <div class=\"explain\">बढ़ा-चढ़ाकर → अतिशयोक्ति</div>\n      </div>\n      <div class=\"trick-mini\">\n        <div class=\"trick-mini-label\">🧠 TRICK</div>\n        <p><strong>अतिशयोक्ति = Exaggeration</strong><br>\n        जो असंभव लगे, बढ़ा-चढ़ाकर हो → अतिशयोक्ति!</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- MANVIKARAN -->\n  <div class=\"alankar-card arthalankar\" onclick=\"toggleCard(this)\">\n    <div class=\"card-header\">\n      <div class=\"card-num\">8</div>\n      <div class=\"card-title-wrap\">\n        <div class=\"card-name\">मानवीकरण अलंकार</div>\n        <div class=\"card-type\">ARTHALANKAR</div>\n      </div>\n      <div class=\"card-arrow\">▼</div>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"def-box\">\n        <strong>परिभाषा:</strong> जहाँ <strong>निर्जीव वस्तुओं या प्रकृति</strong> में <strong>मानवीय क्रियाएँ, भाव या गुण</strong> आरोपित किए जाएँ, वहाँ <strong>मानवीकरण अलंकार</strong> होता है।\n      </div>\n      <div class=\"examples-label\">EXAMPLES</div>\n      <div class=\"example-item\">\n        \"<span class=\"highlight\" style=\"color:#60a5fa\">बीती विभावरी जाग री, अंबर-पनघट में डुबो रही तारा-घट ऊषा-नागरी</span>\"\n        <div class=\"explain\">ऊषा (सुबह) एक नागरी की तरह काम कर रही है → मानवीकरण</div>\n      </div>\n      <div class=\"trick-mini\">\n        <div class=\"trick-mini-label\">🧠 TRICK</div>\n        <p><strong>मानवीकरण = Personification</strong><br>\n        पत्थर रोए, नदी हँसे, पेड़ झुके → मानवीकरण!</p>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<!-- ===== MASTER TRICK ===== -->\n<div id=\"trick\" class=\"section\">\n\n  <div class=\"trick-box\" style=\"margin-top:4px;\">\n    <div class=\"trick-label\">🧠 MASTER MEMORY TRICK</div>\n    <h3>\"अनु यमक श्लेष — उपमा रूपक उत्प्रेक्षा अति मान\"</h3>\n    <p style=\"margin-top:10px; color:#ccc;\">\n      <strong style=\"color:#c084fc\">अनु</strong> = अनुप्रास &nbsp;|&nbsp;\n      <strong style=\"color:#c084fc\">यम</strong> = यमक &nbsp;|&nbsp;\n      <strong style=\"color:#c084fc\">श्ले</strong> = श्लेष<br>\n      <strong style=\"color:#60a5fa\">उप</strong> = उपमा &nbsp;|&nbsp;\n      <strong style=\"color:#60a5fa\">रू</strong> = रूपक &nbsp;|&nbsp;\n      <strong style=\"color:#60a5fa\">उत्</strong> = उत्प्रेक्षा &nbsp;|&nbsp;\n      <strong style=\"color:#60a5fa\">अति</strong> = अतिशयोक्ति &nbsp;|&nbsp;\n      <strong style=\"color:#60a5fa\">मान</strong> = मानवीकरण\n    </p>\n  </div>\n\n  <!-- COMPARISON TABLE -->\n  <div style=\"background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:16px;\">\n    <div style=\"font-size:13px;font-weight:700;color:var(--gold);letter-spacing:1.5px;margin-bottom:14px;font-family:'Baloo 2',sans-serif;\">🆚 CONFUSING PAIRS — एकदम CLEAR करो</div>\n\n    <div style=\"background:#111;border-radius:8px;padding:14px;margin-bottom:12px;border-left:3px solid #c084fc;\">\n      <div style=\"font-size:13px;font-weight:700;color:#c084fc;margin-bottom:8px;\">यमक vs श्लेष</div>\n      <div style=\"font-size:13px;line-height:1.8;color:#ccc;\">\n        <strong style=\"color:#e2e2e2\">यमक:</strong> \"कनक <strong>कनक</strong> ते सौगुनी\" → शब्द 2 बार = अलग अर्थ<br>\n        <strong style=\"color:#e2e2e2\">श्लेष:</strong> \"<strong>पानी</strong> राखिए\" → शब्द 1 बार = 3 अर्थ एक साथ<br><br>\n        <strong style=\"color:#ffd700\">Formula: यमक = 2 बार शब्द | श्लेष = 1 बार शब्द, 2+ अर्थ</strong>\n      </div>\n    </div>\n\n    <div style=\"background:#111;border-radius:8px;padding:14px;margin-bottom:12px;border-left:3px solid #60a5fa;\">\n      <div style=\"font-size:13px;font-weight:700;color:#60a5fa;margin-bottom:8px;\">उपमा vs रूपक</div>\n      <div style=\"font-size:13px;line-height:1.8;color:#ccc;\">\n        <strong style=\"color:#e2e2e2\">उपमा:</strong> \"मुख चंद्र <strong>सा</strong> सुंदर\" → सा/सी है = तुलना<br>\n        <strong style=\"color:#e2e2e2\">रूपक:</strong> \"<strong>मुख-चंद्र</strong>\" → कोई सा/सी नहीं = एक मान लिया<br><br>\n        <strong style=\"color:#ffd700\">Formula: सा/सी = उपमा | बिना सा/सी, compound = रूपक</strong>\n      </div>\n    </div>\n\n    <div style=\"background:#111;border-radius:8px;padding:14px;border-left:3px solid #f39c12;\">\n      <div style=\"font-size:13px;font-weight:700;color:#f39c12;margin-bottom:8px;\">रूपक vs उत्प्रेक्षा</div>\n      <div style=\"font-size:13px;line-height:1.8;color:#ccc;\">\n        <strong style=\"color:#e2e2e2\">रूपक:</strong> \"चरण-कमल\" → पक्का एक मान लिया<br>\n        <strong style=\"color:#e2e2e2\">उत्प्रेक्षा:</strong> \"<strong>मनो</strong> कमल हैं\" → शायद/संभावना<br><br>\n        <strong style=\"color:#ffd700\">Formula: मनो/जनो = उत्प्रेक्षा | बिना मनो = रूपक</strong>\n      </div>\n    </div>\n  </div>\n\n  <!-- KEYWORD TABLE -->\n  <div style=\"background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:16px;\">\n    <div style=\"font-size:13px;font-weight:700;color:var(--gold);letter-spacing:1.5px;margin-bottom:12px;font-family:'Baloo 2',sans-serif;\">⚡ KEYWORD SHORTCUT TABLE</div>\n    <table class=\"overview-table\">\n      <tr><th>जो दिखे</th><th>अलंकार</th></tr>\n      <tr><td>एक व्यंजन बार-बार</td><td><span class=\"type-s\">अनुप्रास</span></td></tr>\n      <tr><td>शब्द 2 बार, अर्थ अलग</td><td><span class=\"type-s\">यमक</span></td></tr>\n      <tr><td>शब्द 1 बार, अर्थ 2+</td><td><span class=\"type-s\">श्लेष</span></td></tr>\n      <tr><td>सा, सी, से, सम, ज्यों</td><td><span class=\"type-a\">उपमा</span></td></tr>\n      <tr><td>compound (मुख-चंद्र), भेद नहीं</td><td><span class=\"type-a\">रूपक</span></td></tr>\n      <tr><td>मनो, जनो, मानो, मनहुँ</td><td><span class=\"type-a\">उत्प्रेक्षा</span></td></tr>\n      <tr><td>असंभव बढ़ावा</td><td><span class=\"type-a\">अतिशयोक्ति</span></td></tr>\n      <tr><td>निर्जीव में जीव वाले काम</td><td><span class=\"type-a\">मानवीकरण</span></td></tr>\n    </table>\n  </div>\n</div>\n\n<!-- ===== QUIZ ===== -->\n<div id=\"quiz\" class=\"section\">\n  <div class=\"score-bar\">\n    <div>आपका Score</div>\n    <div class=\"score-num\" id=\"scoreNum\">0/10</div>\n    <div style=\"font-size:12px;color:var(--muted);margin-top:4px;\">नीचे सारे questions हल करो</div>\n  </div>\n\n  <div id=\"quizContainer\"></div>\n</div>\n\n</div><!-- end .content -->\n\n<script>\nfunction showSection(id) {\n  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));\n  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));\n  document.getElementById(id).classList.add('active');\n  event.target.classList.add('active');\n}\n\nfunction toggleCard(card) {\n  card.classList.toggle('open');\n}\n\n// QUIZ DATA\nconst quizData = [\n  {\n    q: \"'कनक कनक ते सौगुनी, मादकता अधिकाय' — इसमें कौन-सा अलंकार है?\",\n    opts: [\"अनुप्रास\", \"यमक\", \"श्लेष\", \"रूपक\"],\n    ans: 1,\n    explain: \"'कनक' शब्द दो बार आया — एक बार अर्थ 'सोना', दूसरी बार 'धतूरा' → यमक अलंकार\"\n  },\n  {\n    q: \"'चारु चंद्र की चंचल किरणें' — इसमें कौन-सा अलंकार है?\",\n    opts: [\"यमक\", \"श्लेष\", \"अनुप्रास\", \"उपमा\"],\n    ans: 2,\n    explain: \"'च' व्यंजन की बार-बार आवृत्ति → अनुप्रास अलंकार\"\n  },\n  {\n    q: \"'रहिमन पानी राखिए, बिन पानी सब सून' — 'पानी' में कौन-सा अलंकार है?\",\n    opts: [\"यमक\", \"उपमा\", \"श्लेष\", \"रूपक\"],\n    ans: 2,\n    explain: \"'पानी' एक बार आया लेकिन तीन अर्थ: जल, इज्जत, चमक → श्लेष अलंकार\"\n  },\n  {\n    q: \"'मुख चंद्रमा सा सुंदर है' — कौन-सा अलंकार?\",\n    opts: [\"रूपक\", \"उत्प्रेक्षा\", \"उपमा\", \"श्लेष\"],\n    ans: 2,\n    explain: \"वाचक शब्द 'सा' है, तुलना की जा रही है → उपमा अलंकार\"\n  },\n  {\n    q: \"'चरण-कमल बंदौ हरिराई' — कौन-सा अलंकार?\",\n    opts: [\"उपमा\", \"रूपक\", \"उत्प्रेक्षा\", \"अनुप्रास\"],\n    ans: 1,\n    explain: \"चरणों को कमल मान लिया, कोई 'सा/सी' नहीं — भेद नहीं है → रूपक अलंकार\"\n  },\n  {\n    q: \"'मनो नीलमणि-शैल पर आतप परयो प्रभात' — 'मनो' से कौन-सा अलंकार?\",\n    opts: [\"उपमा\", \"रूपक\", \"उत्प्रेक्षा\", \"श्लेष\"],\n    ans: 2,\n    explain: \"'मनो' = संभावना/कल्पना → उत्प्रेक्षा अलंकार\"\n  },\n  {\n    q: \"'वही मनुष्य है कि जो मनुष्य के लिए मरे' — कौन-सा अलंकार?\",\n    opts: [\"रूपक\", \"श्लेष\", \"यमक\", \"अनुप्रास\"],\n    ans: 2,\n    explain: \"'मनुष्य' दो बार, दोनों बार अर्थ अलग → यमक अलंकार (TET का वही question!)\"\n  },\n  {\n    q: \"'हनुमान की पूँछ में लग न पाई आग, लंका सगरी जल गई' — कौन-सा अलंकार?\",\n    opts: [\"मानवीकरण\", \"उत्प्रेक्षा\", \"अतिशयोक्ति\", \"रूपक\"],\n    ans: 2,\n    explain: \"बात को बहुत बढ़ा-चढ़ाकर कहा गया → अतिशयोक्ति अलंकार\"\n  },\n  {\n    q: \"'बीती विभावरी जाग री, ऊषा-नागरी' — कौन-सा अलंकार?\",\n    opts: [\"उपमा\", \"मानवीकरण\", \"रूपक\", \"यमक\"],\n    ans: 1,\n    explain: \"ऊषा (सुबह) को नागरी की तरह काम करते दिखाया — निर्जीव में जीव वाले काम → मानवीकरण\"\n  },\n  {\n    q: \"किस अलंकार में वाचक शब्द (सा, सी, से) नहीं होता लेकिन उपमेय और उपमान को एक मान लिया जाता है?\",\n    opts: [\"उपमा\", \"उत्प्रेक्षा\", \"रूपक\", \"श्लेष\"],\n    ans: 2,\n    explain: \"रूपक में उपमेय और उपमान में अभेद आरोप होता है, कोई वाचक शब्द नहीं होता → रूपक अलंकार\"\n  }\n];\n\nlet score = 0;\nlet answered = new Array(quizData.length).fill(false);\n\nfunction buildQuiz() {\n  const container = document.getElementById('quizContainer');\n  quizData.forEach((q, qi) => {\n    const card = document.createElement('div');\n    card.className = 'quiz-card';\n    card.innerHTML = `\n      <div class=\"quiz-q\">Q${qi+1}. ${q.q}</div>\n      <div class=\"quiz-opts\">\n        ${q.opts.map((opt, oi) => `\n          <button class=\"quiz-opt\" onclick=\"checkAns(${qi}, ${oi}, this)\">(${String.fromCharCode(97+oi)}) ${opt}</button>\n        `).join('')}\n      </div>\n      <div class=\"quiz-explain\" id=\"exp-${qi}\">💡 ${q.explain}</div>\n    `;\n    container.appendChild(card);\n  });\n}\n\nfunction checkAns(qi, chosen, btn) {\n  if (answered[qi]) return;\n  answered[qi] = true;\n  const q = quizData[qi];\n  const opts = btn.parentElement.querySelectorAll('.quiz-opt');\n  opts.forEach(o => o.disabled = true);\n  if (chosen === q.ans) {\n    btn.classList.add('correct');\n    score++;\n  } else {\n    btn.classList.add('wrong');\n    opts[q.ans].classList.add('reveal');\n  }\n  document.getElementById('exp-'+qi).classList.add('show');\n  document.getElementById('scoreNum').textContent = score + '/' + quizData.length;\n}\n\nbuildQuiz();\n</script>\n</body>\n</html>",
