}\n            .psych-card { padding: 1.75rem 1.25rem; border-radius: 24px; }\n        }\n\n        /* ─── Header Elements ─── */\n        .header-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 8px;\n            background: linear-gradient(135deg, #793fc6 0%, #5d2b9f 100%);\n            color: #fff;\n            font-weight: 700;\n            font-size: 0.75rem;\n            text-transform: uppercase;\n            letter-spacing: 0.06em;\n            padding: 0.45rem 1.2rem;\n            border-radius: 100px;\n            margin-bottom: 1.5rem;\n            box-shadow: 0 8px 16px -4px rgba(121, 63, 198, 0.3);\n        }\n\n        .topic-title {\n            font-size: 1.75rem;\n            font-weight: 800;\n            color: #1a0b36;\n            letter-spacing: -0.02em;\n            line-height: 1.25;\n            margin-bottom: 0.75rem;\n        }\n\n        .topic-title span.accent {\n            background: linear-gradient(135deg, #6c3cb0, #9f6ee3);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n\n        .topic-title span.hindi-title {\n            font-size: 1.15rem;\n            font-weight: 500;\n            color: #6a598c;\n            display: inline-block;\n            margin-left: 0.5rem;\n            letter-spacing: 0;\n        }\n\n        .topic-sub {\n            color: #5c4d7d;\n            font-size: 1rem;\n            font-weight: 600;\n            margin-bottom: 2.5rem;\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n\n        .topic-sub::before {\n            content: '';\n            display: block;\n            width: 4px;\n            height: 18px;\n            background: #9f6ee3;\n            border-radius: 4px;\n        }\n\n        /* ─── Clean Question Box ─── */\n        .question-box {\n            background: #ffffff;\n            border-radius: 20px;\n            padding: 2rem;\n            margin-bottom: 2rem;\n            border: 1px solid rgba(121, 63, 198, 0.08);\n            box-shadow: 0 4px 20px -2px rgba(108, 60, 176, 0.03);\n        }\n\n        .question-box .q-label {\n            font-size: 0.75rem;\n            font-weight: 800;\n            text-transform: uppercase;\n            letter-spacing: 0.08em;\n            color: #793fc6;\n            margin-bottom: 0.75rem;\n            display: flex;\n            align-items: center;\n            gap: 6px;\n        }\n\n        .question-box .q-text {\n            font-size: 1.3rem;\n            font-weight: 700;\n            color: #1a0b36;\n            line-height: 1.5;\n        }\n\n        .question-box .q-hindi {\n            display: block;\n            font-weight: 500;\n            color: #5c4d7d;\n            font-size: 1.05rem;\n            margin-top: 0.5rem;\n        }\n\n        /* ─── Minimal Options Grid ─── */\n        .options-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 1rem;\n            margin-bottom: 2rem;\n        }\n\n        @media (max-width: 640px) {\n            .options-grid { grid-template-columns: 1fr; }\n        }\n\n        .option-item {\n            background: rgba(255, 255, 255, 0.6);\n            border-radius: 16px;\n            padding: 1.2rem 1.5rem;\n            border: 1.5px solid rgba(220, 208, 238, 0.5);\n            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .option-item.correct {\n            border-color: #10b981;\n            background: #f0fdf4;\n        }\n\n        .option-item .num {\n            flex-shrink: 0;\n            width: 28px;\n            height: 28px;\n            background: #f4f0fa;\n            border-radius: 8px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 800;\n            font-size: 0.8rem;\n            color: #793fc6;\n        }\n\n        .option-item.correct .num {\n            background: #10b981;\n            color: #fff;\n        }\n\n        .option-item .opt-text {\n            font-weight: 600;\n            color: #1a0b36;\n            font-size: 0.95rem;\n        }\n\n        .option-item .opt-text small {\n            font-weight: 500;\n            color: #6a598c;\n            font-size: 0.9rem;\n            margin-left: 4px;\n        }\n\n        .option-item .check-mark {\n            margin-left: auto;\n            color: #10b981;\n            font-size: 1.2rem;\n        }\n\n        /* ─── Compact Correct Answer Banner ─── */\n        .correct-banner {\n            background: linear-gradient(135deg, #10b981 0%, #059669 100%);\n            color: #fff;\n            border-radius: 14px;\n            padding: 0.8rem 1.5rem;\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            font-weight: 600;\n            font-size: 0.95rem;\n            margin-bottom: 3rem;\n            box-shadow: 0 6px 20px -4px rgba(16, 185, 129, 0.3);\n        }\n\n        /* ─── Interactive Breakdown Grid ─── */\n        .breakdown-title {\n            font-size: 1.2rem;\n            font-weight: 800;\n            color: #1a0b36;\n            margin-bottom: 1.5rem;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        .breakdown-title i { color: #793fc6; }\n\n        .school-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 1.25rem;\n            margin-bottom: 3rem;\n        }\n\n        @media (max-width: 768px) {\n            .school-grid { grid-template-columns: 1fr; }\n        }\n\n        .school-card {\n            background: #ffffff;\n            border-radius: 20px;\n            padding: 1.5rem;\n            border: 1px solid rgba(220, 208, 238, 0.4);\n            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.01);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .school-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 4px;\n            height: 100%;\n            background: #dcd0ee;\n        }\n\n        .school-card.highlight {\n            background: linear-gradient(180deg, #ffffff 0%, #f9fdfb 100%);\n            border-color: rgba(16, 185, 129, 0.15);\n        }\n\n        .school-card.highlight::before {\n            background: #10b981;\n        }\n\n        .school-card .s-name {\n            font-weight: 800;\n            font-size: 1.1rem;\n            color: #1a0b36;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            margin-bottom: 0.25rem;\n        }\n\n        .school-card .s-name .tag {\n            font-size: 0.65rem;\n            font-weight: 700;\n            background: #793fc6;\n            color: #fff;\n            padding: 0.25rem 0.75rem;\n            border-radius: 100px;\n            text-transform: uppercase;\n            letter-spacing: 0.04em;\n        }\n\n        .school-card.highlight .s-name .tag {\n            background: #10b981;\n        }\n\n        .school-card .s-school {\n            font-weight: 700;\n            color: #793fc6;\n            font-size: 0.85rem;\n            margin-bottom: 1rem;\n            display: flex;\n            align-items: center;\n            gap: 6px;\n        }\n\n        .school-card .s-detail {\n            display: flex;\n            flex-direction: column;\n            gap: 0.6rem;\n        }\n\n        .school-card .bullet {\n            font-size: 0.9rem;\n            color: #4a3e65;\n            line-height: 1.5;\n            display: flex;\n            align-items: flex-start;\n            gap: 8px;\n        }\n\n        .school-card .bullet i {\n            color: #793fc6;\n            font-size: 0.85rem;\n            margin-top: 3px;\n        }\n\n        .school-card.highlight .bullet i {\n            color: #10b981;\n        }\n\n        /* ─── Streamlined Extra Concepts ─── */\n        .extra-section {\n            background: #ffffff;\n            border-radius: 24px;\n            padding: 2rem;\n            border: 1px solid rgba(220, 208, 238, 0.4);\n        }\n\n        .extra-section .extra-title {\n            font-weight: 800;\n            color: #1a0b36;\n            font-size: 1.1rem;\n            margin-bottom: 1.25rem;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        .extra-section .extra-title i { color: #793fc6; }\n\n        .extra-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 1.5rem;\n        }\n\n        @media (max-width: 640px) {\n            .extra-grid { grid-template-columns: 1fr; gap: 1.25rem; }\n        }\n\n        .extra-item {\n            padding: 0 0 0 1rem;\n            border-left: 2px dashed #dcd0ee;\n        }\n\n        .extra-item .main-concept {\n            font-weight: 700;\n            color: #1a0b36;\n            font-size: 0.95rem;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            margin-bottom: 0.4rem;\n        }\n\n        .extra-item .main-concept small {\n            font-weight: 500;\n            color: #6a598c;\n        }\n\n        .extra-item .highlight-tag {\n            background: #f4f0fa;\n            color: #793fc6;\n            font-size: 0.65rem;\n            font-weight: 800;\n            padding: 0.15rem 0.5rem;\n            border-radius: 6px;\n        }\n\n        .extra-item .concept-sub {\n            font-size: 0.88rem;\n            color: #5c4d7d;\n            line-height: 1.5;\n        }\n\n        /* ─── Footer Style ─── */\n        .footer-note {\n            margin-top: 3rem;\n            font-size: 0.8rem;\n            color: #8c7fa6;\n            text-align: center;\n            border-top: 1px solid rgba(220, 208, 238, 0.4);\n            padding-top: 1.5rem;\n            font-weight: 500;\n        }\n\n        .footer-note strong { color: #1a0b36; font-weight: 700; }\n    </style>\n</head>\n\n<body>\n\n    <div class=\"psych-card\">\n\n        <!-- Upper Badge -->\n        <div class=\"header-badge\">\n            <i class=\"fas fa-gavel\"></i> Constitution &amp; Education\n        </div>\n\n        <!-- Main Topic Heading -->\n        <div class=\"topic-title\">\n            <span class=\"accent\">Right to Education (RTE)</span> &amp; Constitutional Provisions\n            <span class=\"hindi-title\">(शिक्षा का अधिकार एवं संवैधानिक प्रावधान)</span>\n        </div>\n\n        <div class=\"topic-sub\">\n            Fundamental Rights &amp; Free Compulsory Education · मौलिक अधिकार एवं अनिवार्य शिक्षा\n        </div>\n\n        <!-- Clean Question Layout -->\n        <div class=\"question-box\">\n            <div class=\"q-label\"><i class=\"fas fa-question-circle\"></i> Exam Objective (Image Reference: 3cdc6444-af05-4556-819f-cc3d03979800)</div>\n            <div class=\"q-text\">\n                The right to free and compulsory education for children between age group of 6-14 has been included in Indian Constitution as:\n                <span class=\"q-hindi\">भारतीय संविधान में 6-14 वर्ष के बच्चों के लिए निःशुल्क व अनिवार्य शिक्षा का अधिकार निम्न में शामिल है:</span>\n            </div>\n        </div>\n\n        <!-- Options Configuration -->\n        <div class=\"options-grid\">\n            <div class=\"option-item\">\n                <div class=\"num\">1</div>\n                <div class=\"opt-text\">Article 45 <small>· अनुच्छेद 45</small></div>\n            </div>\n            <div class=\"option-item\">\n                <div class=\"num\">2</div>\n                <div class=\"opt-text\">Article 15 <small>· अनुच्छेद 15</small></div>\n            </div>\n            <div class=\"option-item correct\">\n                <div class=\"num\">3</div>\n                <div class=\"opt-text\">Article 21A <small>· अनुच्छेद 21A</small></div>\n                <div class=\"check-mark\"><i class=\"fas fa-check-circle\"></i></div>\n            </div>\n            <div class=\"option-item\">\n                <div class=\"num\">4</div>\n                <div class=\"opt-text\">Article 26 <small>· अनुच्छेद 26</small></div>\n            </div>\n        </div>\n\n        <!-- Dynamic Success Banner -->\n        <div class=\"correct-banner\">\n            <i class=\"fas fa-award\"></i>\n            Correct Option: <strong>Article 21A</strong> · अनुच्छेद 21A\n        </div>\n\n        <!-- Detailed Breakdown -->\n        <div class=\"breakdown-title\">\n            <i class=\"fas fa-list-check\"></i> Pointed Options Breakdown (Bilingual)\n        </div>\n\n        <div class=\"school-grid\">\n            <!-- Article 21A Info -->\n            <div class=\"school-card highlight\">\n                <div class=\"s-name\">Article 21A <span class=\"tag\">Correct</span></div>\n                <div class=\"s-school\"><i class=\"fas fa-shield-halved\"></i> Fundamental Right · मौलिक अधिकार</div>\n                <div class=\"s-detail\">\n                    <div class=\"bullet\"><i class=\"fas fa-circle-dot\"></i> <span>Added via the <strong>86th Constitutional Amendment Act, 2002</strong> (86वाँ संविधान संशोधन).</span></div>\n                    <div class=\"bullet\"><i class=\"fas fa-circle-dot\"></i> <span>Makes free and compulsory education a **Fundamental Right** for children aged 6 to 14 years.</span></div>\n                    <div class=\"bullet\"><i class=\"fas fa-circle-dot\"></i> <span>RTE Act was enacted in 2009 and came into effect on **1st April 2010** (1 अप्रैल 2010 से लागू).</span></div>\n                </div>\n            </div>\n\n            <!-- Article 45 Info -->\n            <div class=\"school-card\">\n                <div class=\"s-name\">Article 45 <span class=\"tag\">DPSP</span></div>\n                <div class=\"s-school\"><i class=\"fas fa-scale-balanced\"></i> Directive Principles · राज्य के नीति निदेशक तत्व</div>\n                <div class=\"s-detail\">\n                    <div class=\"bullet\"><i class=\"fas fa-circle-dot\"></i> <span>Originally contained the provision for free and compulsory education before 2002.</span></div>\n                    <div class=\"bullet\"><i class=\"fas fa-circle-dot\"></i> <span>Post 86th Amendment, it now states: \"Provision for **early childhood care and education** (ECCE) to children below the age of 6 years\" (0-6 वर्ष तक के बच्चों की देखभाल और शिक्षा).</span></div>\n                </div>\n            </div>\n\n            <!-- Article 15 Info -->\n            <div class=\"school-card\">\n                <div class=\"s-name\">Article 15 <span class=\"tag\">Equality</span></div>\n                <div class=\"s-school\"><i class=\"fas fa-users-slash\"></i> Prohibition of Discrimination · भेदभाव का निषेध</div>\n                <div class=\"s-detail\">\n                    <div class=\"bullet\"><i class=\"fas fa-circle-dot\"></i> <span>Prohibits discrimination on grounds of religion, race, caste, sex, or place of birth.</span></div>\n                    <div class=\"bullet\"><i class=\"fas fa-circle-dot\"></i> <span>**Article 15(3)** allows the State to make special provisions for women and children (महिला व बच्चों के लिए विशेष प्रावधान).</span></div>\n                </div>\n            </div>\n\n            <!-- Article 26 Info -->\n            <div class=\"school-card\">\n                <div class=\"s-name\">Article 26 <span class=\"tag\">Freedom</span></div>\n                <div class=\"s-school\"><i class=\"fas fa-church\"></i> Religious Affairs · धार्मिक स्वतंत्रता</div>\n                <div class=\"s-detail\">\n                    <div class=\"bullet\"><i class=\"fas fa-circle-dot\"></i> <span>Provides the freedom to manage religious affairs.</span></div>\n                    <div class=\"bullet\"><i class=\"fas fa-circle-dot\"></i> <span>Allows religious denominations to establish and maintain institutions for religious and charitable purposes.</span></div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Extra TET Specific Concepts -->\n        <div class=\"extra-section\">\n            <div class=\"extra-title\"><i class=\"fas fa-lightbulb\"></i> Core TET Insights</div>\n            <div class=\"extra-grid\">\n                <div class=\"extra-item\">\n                    <div class=\"main-concept\">Article 51A(k) <small>· मौलिक कर्तव्य</small> <span class=\"highlight-tag\">Duty 11</span></div>\n                    <div class=\"concept-sub\">Also added by the **86th Amendment**. It places a fundamental duty on parents/guardians to provide education opportunities to their child aged 6-14.</div>\n                </div>\n                <div class=\"extra-item\">\n                    <div class=\"main-concept\">RTE 2009 Seat Quota <small>· सीट आरक्षण</small></div>\n                    <div class=\"concept-sub\">Mandates **25% reservation** for children from economically weaker sections (EWS) and disadvantaged groups in private unaided schools.</div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Bottom Footer -->\n        <div class=\"footer-note\">\n            <i class=\"fas fa-graduation-cap\"></i> High-Yield TET Study Resource · <strong>86th Amendment Framework (2002)</strong>\n        </div>\n\n    </div>\n\n</body>\n</html>",
