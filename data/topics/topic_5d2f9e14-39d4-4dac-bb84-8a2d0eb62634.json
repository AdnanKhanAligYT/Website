{
    "id": "5d2f9e14-39d4-4dac-bb84-8a2d0eb62634",
    "subjectId": "38fe1eb2-f38f-4dc6-9e65-8711d6af8f11",
    "name": "📚 हिंदी व्याकरण (काव्य शास्त्र – 33 संचारी भाव)",
    "description": "<!DOCTYPE html>\n<html lang=\"hi\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>33 संचारी भाव - हिंदी काव्य</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            background: linear-gradient(145deg, #f9f3e9 0%, #f0e6d3 100%);\n            font-family: 'Segoe UI', 'Mangal', 'Arial', sans-serif;\n            padding: 2rem 1rem;\n            color: #2e241f;\n            min-height: 100vh;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            background: rgba(255, 250, 242, 0.7);\n            backdrop-filter: blur(2px);\n            border-radius: 3rem 3rem 2rem 2rem;\n            padding: 2rem 1.5rem;\n            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);\n            border: 1px solid #e5d5c0;\n        }\n\n        h1 {\n            text-align: center;\n            font-size: 2.8rem;\n            font-weight: 600;\n            color: #4d2e1b;\n            letter-spacing: 4px;\n            text-shadow: 4px 4px 0 #e7d4be, 0 2px 10px rgba(150, 90, 40, 0.1);\n            margin-bottom: 0.3rem;\n            word-break: break-word;\n        }\n\n        .subhead {\n            text-align: center;\n            font-size: 1.2rem;\n            font-weight: 300;\n            color: #5f4030;\n            border-top: 2px dashed #c9b29b;\n            border-bottom: 2px dashed #c9b29b;\n            padding: 0.8rem 0;\n            margin: 0 0 2.5rem 0;\n            letter-spacing: 2px;\n            background: rgba(235, 216, 196, 0.2);\n            border-radius: 40px;\n            width: fit-content;\n            margin-left: auto;\n            margin-right: auto;\n            padding-left: 2rem;\n            padding-right: 2rem;\n        }\n\n        .grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));\n            gap: 1.2rem;\n            justify-content: center;\n        }\n\n        .card {\n            background: #fffcf7;\n            border-radius: 28px 12px 28px 12px;\n            padding: 1.2rem 0.5rem;\n            box-shadow: 0 8px 18px rgba(100, 60, 30, 0.08), 0 2px 6px rgba(0, 0, 0, 0.02);\n            transition: all 0.25s ease;\n            border: 1px solid #eee1d0;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            text-align: center;\n            backdrop-filter: blur(2px);\n            background: rgba(255, 250, 242, 0.7);\n        }\n\n        .card:hover {\n            transform: translateY(-8px) scale(1.01);\n            background: #fffdf9;\n            border-color: #c7a78b;\n            box-shadow: 0 18px 30px rgba(110, 70, 40, 0.12);\n        }\n\n        .card-number {\n            display: inline-block;\n            background: #8b6b4f;\n            color: #fef3e4;\n            font-size: 0.8rem;\n            font-weight: 600;\n            padding: 0.2rem 0.8rem;\n            border-radius: 40px;\n            letter-spacing: 1px;\n            margin-bottom: 0.5rem;\n            box-shadow: 0 2px 6px rgba(0,0,0,0.1);\n        }\n\n        .card h3 {\n            font-size: 1.3rem;\n            font-weight: 600;\n            color: #2b1b12;\n            margin: 0.3rem 0 0.2rem;\n            line-height: 1.3;\n            padding: 0 0.2rem;\n        }\n\n        .card .sanskrit {\n            font-size: 0.9rem;\n            font-weight: 300;\n            color: #6b4f3a;\n            background: #efe3d6;\n            padding: 0.2rem 0.8rem;\n            border-radius: 30px;\n            display: inline-block;\n            margin: 0.2rem 0 0.4rem;\n            letter-spacing: 0.5px;\n        }\n\n        .card .meaning {\n            font-size: 0.8rem;\n            line-height: 1.4;\n            color: #3e2c20;\n            padding: 0 0.3rem;\n            background: rgba(235, 215, 195, 0.2);\n            border-radius: 20px;\n            padding: 0.3rem 0.6rem;\n            width: 100%;\n        }\n\n        .footer-note {\n            text-align: center;\n            margin-top: 3.5rem;\n            font-size: 0.95rem;\n            color: #4f3a2b;\n            border-top: 1px solid #dacbbc;\n            padding-top: 1.8rem;\n            font-style: italic;\n            letter-spacing: 1px;\n            background: rgba(235, 215, 195, 0.1);\n            border-radius: 60px;\n            padding-bottom: 0.5rem;\n        }\n\n        .footer-note span {\n            background: #dacbbc;\n            padding: 0.2rem 1.2rem;\n            border-radius: 40px;\n            color: #2f1f13;\n            font-weight: 400;\n        }\n\n        @media (max-width: 600px) {\n            h1 {\n                font-size: 2.2rem;\n                letter-spacing: 2px;\n            }\n            .grid {\n                grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\n                gap: 0.9rem;\n            }\n            .card h3 {\n                font-size: 1.1rem;\n            }\n            .container {\n                padding: 1.2rem 0.8rem;\n            }\n            .subhead {\n                font-size: 1rem;\n                padding: 0.4rem 1rem;\n            }\n        }\n\n        @media (max-width: 400px) {\n            .grid {\n                grid-template-columns: repeat(2, 1fr);\n                gap: 0.6rem;\n            }\n            .card {\n                padding: 0.8rem 0.3rem;\n            }\n            .card h3 {\n                font-size: 1rem;\n            }\n        }\n    </style>\n</head>\n<body>\n<div class=\"container\">\n    <h1>🌺 ३३ संचारी भाव 🌺</h1>\n    <div class=\"subhead\">✦ भावों का काव्य · संचारी रस ✦</div>\n\n    <div class=\"grid\" id=\"bhavaGrid\">\n        <!-- कार्ड्स जावास्क्रिप्ट द्वारा भरे जाएँगे -->\n    </div>\n\n    <div class=\"footer-note\">\n        <span>✦ काव्य के ३३ संचारी भाव · हृदय के रंग ✦</span>\n    </div>\n</div>\n\n<script>\n    (function() {\n        // 33 संचारी भाव (हिंदी नाम, संस्कृत नाम, संक्षिप्त अर्थ)\n        const bhavaData = [\n            { num: 1, name: \"निर्वेद\", sanskrit: \"निर्वेदः\", meaning: \"वैराग्य, उदासीनता\" },\n            { num: 2, name: \"विषाद\", sanskrit: \"विषादः\", meaning: \"शोक, खिन्नता\" },\n            { num: 3, name: \"दैन्य\", sanskrit: \"दैन्यम्\", meaning: \"दीनता, लाचारी\" },\n            { num: 4, name: \"ग्लानि\", sanskrit: \"ग्लानिः\", meaning: \"थकावट, पश्चाताप\" },\n            { num: 5, name: \"शंका\", sanskrit: \"शङ्का\", meaning: \"संदेह, डर\" },\n            { num: 6, name: \"असूया\", sanskrit: \"असूया\", meaning: \"ईर्ष्या, द्वेष\" },\n            { num: 7, name: \"मद\", sanskrit: \"मदः\", meaning: \"गर्व, नशा\" },\n            { num: 8, name: \"श्रम\", sanskrit: \"श्रमः\", meaning: \"परिश्रम, थकान\" },\n            { num: 9, name: \"आलस्य\", sanskrit: \"आलस्यम्\", meaning: \"सुस्ती, आलस\" },\n            { num: 10, name: \"दैन्य\", sanskrit: \"दैन्यम्\", meaning: \"दीनता, अभाव\" },\n            { num: 11, name: \"चिन्ता\", sanskrit: \"चिन्ता\", meaning: \"फिक्र, व्याकुलता\" },\n            { num: 12, name: \"मोह\", sanskrit: \"मोहः\", meaning: \"आसक्ति, भ्रम\" },\n            { num: 13, name: \"धृति\", sanskrit: \"धृतिः\", meaning: \"धैर्य, संतोष\" },\n            { num: 14, name: \"हर्ष\", sanskrit: \"हर्षः\", meaning: \"आनंद, उल्लास\" },\n            { num: 15, name: \"जड़ता\", sanskrit: \"जड़ता\", meaning: \"अचेतना, स्तब्धता\" },\n            { num: 16, name: \"गर्व\", sanskrit: \"गर्वः\", meaning: \"अहंकार, घमंड\" },\n            { num: 17, name: \"वितर्क\", sanskrit: \"वितर्कः\", meaning: \"तर्क, विचार\" },\n            { num: 18, name: \"अवहित्था\", sanskrit: \"अवहित्था\", meaning: \"भाव छिपाना, संकोच\" },\n            { num: 19, name: \"उग्रता\", sanskrit: \"उग्रता\", meaning: \"क्रोध, उत्तेजना\" },\n            { num: 20, name: \"मति\", sanskrit: \"मतिः\", meaning: \"बुद्धि, समझ\" },\n            { num: 21, name: \"मरीचि\", sanskrit: \"मरीचिः\", meaning: \"किरण, आभास\" },\n            { num: 22, name: \"शील\", sanskrit: \"शीलम्\", meaning: \"स्वभाव, चरित्र\" },\n            { num: 23, name: \"स्मृति\", sanskrit: \"स्मृतिः\", meaning: \"याद, स्मरण\" },\n            { num: 24, name: \"त्रास\", sanskrit: \"त्रासः\", meaning: \"भय, दहशत\" },\n            { num: 25, name: \"संभ्रम\", sanskrit: \"संभ्रमः\", meaning: \"घबराहट, हड़बड़ी\" },\n            { num: 26, name: \"व्रीडा\", sanskrit: \"व्रीडा\", meaning: \"लज्जा, शर्म\" },\n            { num: 27, name: \"चपलता\", sanskrit: \"चपलता\", meaning: \"चंचलता, अस्थिरता\" },\n            { num: 28, name: \"आवेग\", sanskrit: \"आवेगः\", meaning: \"वेग, उत्कंठा\" },\n            { num: 29, name: \"जागृति\", sanskrit: \"जागृतिः\", meaning: \"जागना, सजगता\" },\n            { num: 30, name: \"स्वप्न\", sanskrit: \"स्वप्नः\", meaning: \"सपना, कल्पना\" },\n            { num: 31, name: \"अपस्मार\", sanskrit: \"अपस्मारः\", meaning: \"स्मृति भूल, उन्माद\" },\n            { num: 32, name: \"विबोध\", sanskrit: \"विबोधः\", meaning: \"ज्ञान, चेतना\" },\n            { num: 33, name: \"माया\", sanskrit: \"माया\", meaning: \"जादू, छल, ब्रह्म\" }\n        ];\n\n        const grid = document.getElementById('bhavaGrid');\n        if (!grid) return;\n\n        // सभी 33 कार्ड्स बनाएँ\n        bhavaData.forEach(item => {\n            const card = document.createElement('div');\n            card.className = 'card';\n\n            // नंबर बैज\n            const numberSpan = document.createElement('span');\n            numberSpan.className = 'card-number';\n            numberSpan.textContent = `# ${item.num}`;\n            card.appendChild(numberSpan);\n\n            // मुख्य नाम (हिंदी)\n            const nameHeading = document.createElement('h3');\n            nameHeading.textContent = item.name;\n            card.appendChild(nameHeading);\n\n            // संस्कृत नाम\n            const sanskritSpan = document.createElement('span');\n            sanskritSpan.className = 'sanskrit';\n            sanskritSpan.textContent = item.sanskrit;\n            card.appendChild(sanskritSpan);\n\n            // अर्थ\n            const meaningDiv = document.createElement('div');\n            meaningDiv.className = 'meaning';\n            meaningDiv.textContent = item.meaning;\n            card.appendChild(meaningDiv);\n\n            grid.appendChild(card);\n        });\n    })();\n</script>\n\n<!-- अतिरिक्त सजावट - कुछ पुरानी काव्य छटा -->\n</body>\n</html>",
